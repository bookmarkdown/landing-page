{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmd-landing-page",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}