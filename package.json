{
  "name": "bmd-landing-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev --port 8787",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm build && pnpm test:e2e",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:pages": "pnpm build && wrangler pages deploy --cwd cloudflare/pages"
  },
  "dependencies": { "lucide": "^0.468.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}